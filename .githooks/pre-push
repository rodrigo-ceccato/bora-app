#!/usr/bin/env sh
# Validate version tags before they leave this checkout. CI repeats this check
# so a missing local hook can never result in a production deployment.
pushes_main=false

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main)
      [ "$local_sha" = "0000000000000000000000000000000000000000" ] || pushes_main=true
      ;;
  esac

  case "$local_ref" in
    refs/tags/v*)
      [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
      tag=${local_ref#refs/tags/}
      node scripts/validate-release-tag.mjs "$tag" || exit 1
      ;;
  esac
done

if [ "$pushes_main" = true ]; then
  echo "Running local verification gates before pushing main..."
  npm run verify || exit 1
  npm run verify:ops || exit 1
  npm run verify:static || exit 1
  npm run test:migrations || exit 1

  echo "Running the local Compose E2E suite before pushing main..."
  npm run test:e2e:local || exit 1
fi
