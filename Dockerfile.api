FROM node:22.23.2-alpine3.24@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32

WORKDIR /app
ENV NODE_ENV=production

COPY --chown=node:node server/package.json server/package-lock.json ./
RUN npm ci --omit=dev

COPY --chown=node:node server ./server

# The API starts with node directly and never needs package-manager tooling at
# runtime. Removing npm/Corepack/Yarn shrinks the attack surface and keeps their
# build-only dependency advisories out of the production image.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /opt/yarn-* \
    && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/yarn /usr/local/bin/yarnpkg

EXPOSE 8787
USER 1000:1000
CMD ["sh", "-c", "node server/migrate.mjs && node server/index.mjs"]
