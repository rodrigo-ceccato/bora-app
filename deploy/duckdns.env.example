# Legacy manual setup template. Production uses the DUCKDNS_TOKEN GitHub
# Environment secret; that value is never synced by deploy/release.sh.
#
#   cp deploy/duckdns.env.example deploy/duckdns.env
#   $EDITOR deploy/duckdns.env
#   ./deploy/setup-duckdns.sh
#
# DUCKDNS_DOMAIN is the bare label only, not the full hostname:
# "bora-app", not "bora-app.duckdns.org".
DUCKDNS_DOMAIN=bora-app
DUCKDNS_TOKEN=paste-your-duckdns-token-here
