{
  "name": "bora-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bora: shareable event planning polls built with Ionic React, Vite, Capacitor, and Supabase.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "lint": "eslint .",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "cap:sync": "cap sync"
  },
  "dependencies": {
    "@capacitor/app": "latest",
    "@capacitor/core": "latest",
    "@capacitor/haptics": "latest",
    "@capacitor/keyboard": "latest",
    "@capacitor/status-bar": "latest",
    "@ionic/react": "latest",
    "@ionic/react-router": "latest",
    "@supabase/supabase-js": "latest",
    "@vitejs/plugin-react": "latest",
    "ionicons": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router": "^5.3.4",
    "react-router-dom": "^5.3.4",
    "vite": "latest"
  },
  "devDependencies": {
    "@capacitor/cli": "latest",
    "@eslint/js": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/react-router": "^5.1.20",
    "@types/react-router-dom": "^5.3.3",
    "eslint": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vitest": "latest"
  }
}
